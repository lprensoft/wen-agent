# 密钥与本地配置
.env
config.yaml
.claude/

# 本地会话数据与运行时状态（models.json 含明文 API Key）
sessions/
plugins.state.json
models.json
auth.json
wen.lock

# 插件的持久化目录（记忆条目与压缩归档等；锚定根目录，源码在 internal/plugin/ 下不受影响）
/plugins/

# 构建产物与运行日志（锚定根目录，避免误伤 cmd/wen/）
/wen
/wen.exe
*.log
/wen.exe~

# Windows 上 go test 的临时构建目录（GOTMPDIR，躲开杀毒软件对 %TEMP% 的拦截，见 CLAUDE.md「常用命令」）
/.gotmp/

# 分发打包产物（发布 workflow 在这两处落地，本地跑同一套脚本时也一样）
/dist/
/build/

# 已安装的外源插件包（Agent Plugins 格式，锚定根目录）
/bundles/
/wen-test.exe
